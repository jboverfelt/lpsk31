# =====================================================================
# lpsk31 RUNTIME CONFIGURATION FILE: lpsk31rc
# =====================================================================
#
# lpsk31 reads this file at startup. The file uses a simple
# key = value format organized into [sections]. Lines that are blank
# or start with '#' are ignored. The supported sections are:
#
#   [sound]     - sound card and capture/playback settings
#   [runtime]   - runtime tuning settings
#   [rig]       - rig control (Hamlib) settings
#   [operator]  - operator call-sign, name, QTH and QTH locator
#   [macro-N]   - one section per macro (N = 1..9)
#
# The file is looked up in the following locations, in order:
#   1. $XDG_CONFIG_HOME/lpsk31/lpsk31rc   (default ~/.config/lpsk31/lpsk31rc)
#   2. <XDG_CONFIG_DIRS>/lpsk31/lpsk31rc  (default /etc/xdg/lpsk31/lpsk31rc)
#   3. ~/lpsk31/lpsk31rc (legacy; auto-migrated to (1) on first run)
#
# =====================================================================

[sound]
# ALSA sound card name: Default is hw:0
card = hw:0

# Capture source and level elements from the ALSA mixer.
# Use "--" if the device has no such element or control.
capture-source = Line
capture-volume = Capture
master-volume  = Master
pcm-volume     = PCM

# Capture volume: Useful range ~10-100. Default is 50.
capture-level = 50

# Playback volume: Useful range ~10-90. Default is 50.
playback-level = 50

# ALSA "channel" for use in mixer setup: Default is 1
channel = 1

# Number of channels: 1=Mono 2=Stereo
channels = 2

# Channel in use: 0=Left 1=Right
use-channel = 1

[runtime]
# Squelch threshold: Useful range ~3-10. Default is 5.
# A zero setting disables the squelch function.
squelch = 5

# Steady tone duration in sec: Default is 1 sec.
# This is the steady tone transmitted at the beginning and tail
# end of a transmission (pre-amble and post-amble).
tone-duration = 1

# Number of reversals following and preceding the steady tone:
# Default is 24. These phase reversals are part of the PSK31
# pre-amble and post-amble used for synching and squelching.
num-reversals = 24

# Morse encoder speed in wpm: Default is 20 wpm
wpm = 20

# Transmit window word-wrap column: Default is 70
word-wrap = 70

[rig]
# Rig control via Hamlib.
#
# If you run a rigctld server, leave `model` blank and set
# `device` to the host:port of the server (e.g. 127.0.0.1:4532).
device = 127.0.0.1:4532
#
# If you control a radio directly (no rigctld), set `model` to the
# Hamlib model ID for your rig and `device` to the device path.
# Examples: 3073 = Icom IC-7300. Run `rigctl -l` for the model list.
# model = 3073
# device = /dev/ic7300
#
# enabled = true|false. When true, rig control auto-connects at startup.
# Default is false; rig control is toggled with the 't' key.
#
# When enabled, lpsk31 sets the rig to USB or USB-D (digital USB; e.g.
# PKTUSB in rigctl terms) for BPSK and QPSK-USB, LSB or its digital
# equivalent for QPSK-LSB, in both transmit and receive direction.
enabled = false

[operator]
# Call-sign: Maximum 16 characters. USE CAPITAL LETTERS. Fill in your own!
call = YOUR_CALL

# Name: Maximum 16 characters
name = YOUR_NAME

# QTH: Maximum 20 characters
qth = YOUR_QTH

# QTH locator: Maximum 6 characters
loc = LOCATR

# =====================================================================
# Macros (Prepared messages for transmission)
# =====================================================================
#
# Macros are bound to F1-F9 in section order: [macro-1] is F1,
# [macro-2] is F2, ... [macro-9] is F9.
#
# Each macro has:
#   label = a short label (max 16 characters) shown in the UI
#   text  = the message text, one line per line
#
# Lines in the macro text that start with '#' or with whitespace
# are ignored. Blank lines are skipped.
#
# Lines ending with a tilde ~ signify that lpsk31 should remain
# in transmit mode so that text can be appended to the macro manually,
# e.g. signal report, name etc. The up arrow ^ signifies that a
# 'new-line' signal should be sent before the text.
#
# Tags in Macros
# =============
#
# The following tags are recognized and replaced during transmission:
#
#   <own-call>  <own-name>  <own-qth>  <own-loc>  <own-rst>
#   <rem-call>  <rem-name>  <rem-qth>  <rem-loc>  <rem-rst>
#   <date-time>  <op-freq>  <app-version>
#
# <op-freq> expands to the operating frequency as reported by the
# connected rig (in MHz) or to the value in the QSO record, if not
# set by the rig.
#
# =====================================================================

[macro-1]
label = CALL CQ
text =
^CQ CQ CQ de <own-call> <own-call> <own-call>
CQ CQ CQ de <own-call> <own-call> <own-call>
CQ CQ CQ de <own-call> <own-call> <own-call>
pse KKK

[macro-2]
label = CALLSIGNS/HELLO
text =
^<rem-call> <rem-call> <rem-call> de <own-call> <own-call> <own-call>
Hello dr op and tks for your call ~

[macro-3]
label = RST/NAME/QTH/QSL
text =
^Your RST: <rem-rst> <rem-rst> <rem-rst>
My name: <own-name>  <own-name>
My QTH: <own-qth> <own-qth>
My Loc: <own-loc> <own-loc>
QSL is OK via bureau or direct

[macro-4]
label = KEYBOARD BTU
text =
^Now keys BTU dr op <rem-name>
<rem-call> <rem-call> de <own-call> <own-call> pse KKKN

[macro-5]
label = REMT & OWN CALLS
text =
^<rem-call> <rem-call> de <own-call> <own-call> ~

[macro-6]
label = MY STATION INFO
text =
^My station info:
Rig: YOUR RIG o/p 30W  Ant: YOUR ANTENNA
Computer: YOUR COMPUTER Sound: YOUR SOUND CARD
O/S: YOUR LINUX DISTRO  Software: <app-version> ~

[macro-7]
label = FINAL & SIGN-OFF
text =
^My tks for a nice PSK31 QSO dr op <rem-name>.
I wish you and your family best 73's and good health.
Until we meet again, good luck with PSK31 dx and bye-bye.
Logged by <app-version> on <date-time> UTC on <op-freq> MHz.
<rem-call> <rem-call> de <own-call> <own-call> SKSK *

[macro-8]
label = REPLY TO CQ CALL
text =
^<rem-call> <rem-call> de <own-call> <own-call> <own-call> pse KKK

[macro-9]
label = QRZ de YOUR CALL
text =
^QRZ QRZ QRZ de <own-call> <own-call> <own-call> pse KKK
